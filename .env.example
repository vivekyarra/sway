# Copy to .env. Every value is optional: with nothing set, Sway runs end to end in PayPal test mode
# with its built-in reasoning engine; add credentials to switch to PayPal Sandbox and an AI model.

# Database (default: postgres://sway@localhost:5432/sway?sslmode=disable)
DATABASE_URL=postgres://sway:sway@localhost:5432/sway?sslmode=disable

# PayPal Sandbox. Setting client id + secret switches checkout, refunds and payouts to the Sandbox REST API.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Published in the judge tour so judges can complete a sandbox checkout.
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=
# Map catalog creators to Sandbox personal accounts you can log into to watch payouts land.
CREATOR_PAYPAL_EMAILS=c_priya=,c_maya=,c_dev=,c_tomas=

# AI model. Set ONE key; it powers the shopping agent, injection screening and creator explanations.
# Google Gemini (free tier, key from https://aistudio.google.com/apikey):
GEMINI_API_KEY=
# Anthropic Claude:
ANTHROPIC_API_KEY=
# Any OpenAI-compatible API (OpenAI, Groq, OpenRouter, a local server):
AI_API_KEY=
AI_BASE_URL=
# Optional overrides: AI_MODEL (or DECISION_MODEL / EXPLAIN_MODEL), AI_RPM (requests per minute pacing).
LLM_CONCURRENCY=8

# Channel3 live catalog (optional)
CHANNEL3_API_KEY=
CATALOG_MODE=curated

# Money and attribution
# Merchant tools for walkthroughs: fast-forward vesting, test disputes, reset
TEST_TOOLS=true
VESTING_WINDOW_SECONDS=120
COMMISSION_RATE_BPS=800
SWAY_FEE_BPS=1500
MIN_PAYOUT_CENTS=50
ATTRIBUTION_SAMPLES=3
ATTRIBUTION_PLAYERS=6
MAX_ATTRIBUTION_CALLS=250

# Runtime
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
WORKER_INLINE=true
AUTO_PAYOUT_SECONDS=30
TRUST_PROXY=false
