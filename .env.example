# Copy to .env. Every value is optional: with nothing set, Sway runs end to end on its labelled
# PayPal simulator and deterministic offline agent, and the UI says so.

# Database (default: postgres://sway@localhost:5432/sway?sslmode=disable)
DATABASE_URL=postgres://sway:sway@localhost:5432/sway?sslmode=disable

# PayPal (sandbox). Setting client id + secret switches from the simulator to the real sandbox API.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Published in the judge tour so judges can complete a sandbox checkout.
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=
# Map demo creators to sandbox personal accounts you can log into to watch payouts land.
CREATOR_PAYPAL_EMAILS=c_priya=,c_maya=,c_dev=,c_tomas=

# Claude. Setting a key switches the agent, injection screening and explanations to Claude.
ANTHROPIC_API_KEY=
DECISION_MODEL=claude-haiku-5-5
EXPLAIN_MODEL=claude-haiku-5-5
LLM_CONCURRENCY=8

# Channel3 live catalog (optional)
CHANNEL3_API_KEY=
CATALOG_MODE=demo

# Money and attribution
DEMO_MODE=true
VESTING_WINDOW_SECONDS=120
COMMISSION_RATE_BPS=800
SWAY_FEE_BPS=1500
MIN_PAYOUT_CENTS=50
ATTRIBUTION_SAMPLES=3
ATTRIBUTION_PLAYERS=6
MAX_ATTRIBUTION_CALLS=250

# Runtime
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
WORKER_INLINE=true
AUTO_PAYOUT_SECONDS=30
TRUST_PROXY=false
