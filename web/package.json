{
  "name": "sway-web",
  "version": "1.0.0",
  "private": true,
  "description": "Sway web UI: shopper, creator and merchant surfaces (static export served by the Go engine).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "embed": "rm -rf ../engine/internal/webui/dist && mkdir -p ../engine/internal/webui/dist && cp -r out/. ../engine/internal/webui/dist/ && touch ../engine/internal/webui/dist/.gitkeep"
  },
  "dependencies": {
    "@paypal/react-paypal-js": "^10.6.1",
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "next": "^16.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3"
  }
}
